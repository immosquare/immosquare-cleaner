{
  "name":         "immosquare-cleaner",
  "//":           [
    "TypeScript 7 provides tsc through @typescript/native.",
    "ESLint and SonarJS use the TypeScript 6 API through the official @typescript/typescript6 alias.",
    "Keep this alias until both tools support the native TypeScript API."
  ],
  "private":      true,
  "dependencies": {
    "@babel/parser":                    "^8.0.7",
    "@eslint/js":                       "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser":        "^8.71.2",
    "@typescript/native":               "npm:typescript@^7.0.2",
    "eslint":                           "^10.13.0",
    "eslint-plugin-align-import":       "^1.0.0",
    "eslint-plugin-erb":                "^2.1.1",
    "eslint-plugin-prefer-arrow":       "^1.2.3",
    "eslint-plugin-sonarjs":            "^4.2.2",
    "eslint-plugin-unused-imports":     "^4.4.1",
    "prettier":                         "^3.9.10",
    "typescript":                       "npm:@typescript/typescript6@^6.0.2"
  }
}
