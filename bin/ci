#!/usr/bin/env zsh
set -e

##============================================================##
## Portable CI entry point: installs the dependencies, then runs
## the gem test suite. The runner selects Ruby and the gemset from
## .ruby-version and .ruby-gemset before calling this script.
##============================================================##
cd -- "${0:A:h:h}"

##============================================================##
## The development group holds editor and linter tooling only.
## Install and tests use the same groups, even when init and test
## run as two separate processes.
## test/coverage_helper.rb, loaded by the Rake task, starts coverage.
##============================================================##
export BUNDLE_WITHOUT="development"
export COVERAGE="${COVERAGE:-true}"

ci_action="${1:-all}"
if [ "$#" -gt 1 ]; then
    echo "Usage: $0 [all|init|test]" >&2
    exit 1
fi

case "$ci_action" in
    all|init|test) ;;
    *)
        echo "Usage: $0 [all|init|test]" >&2
        exit 1
        ;;
esac

echo "Using Ruby : $(ruby --version)"

if [ "$ci_action" = "all" ] || [ "$ci_action" = "init" ]; then
    bundle install
    bun install --frozen-lockfile
fi

##============================================================##
## The Minitest suite runs through the Rake task; bun provides
## ESLint and Prettier, which the tests exercise.
##============================================================##
if [ "$ci_action" = "all" ] || [ "$ci_action" = "test" ]; then
    exec bundle exec rake test
fi
